<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="head.additional">
            <block class="Magento\Framework\View\Element\Template" name="webramos.gtm.head"
                   template="WebRamos_GoogleTagManager::head.phtml" before="-">
                <arguments>
                    <argument name="view_model" xsi:type="object">WebRamos\GoogleTagManager\ViewModel\Loader</argument>
                </arguments>
            </block>
        </referenceBlock>
        <referenceContainer name="after.body.start">
            <block class="Magento\Framework\View\Element\Template" name="webramos.gtm.noscript"
                   template="WebRamos_GoogleTagManager::noscript.phtml" before="-">
                <arguments>
                    <argument name="view_model" xsi:type="object">WebRamos\GoogleTagManager\ViewModel\Loader</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
